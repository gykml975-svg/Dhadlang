#!/usr/bin/env sh
set -eu

GRADLE_VERSION="8.7"
GRADLE_SHA256="544c35d6bd849ae8a5ed0bcea39ba677dc40f49df7d1835561582da2009b961d"
CACHE_BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/dhad-gradle"
INSTALL_DIR="$CACHE_BASE/gradle-$GRADLE_VERSION"
GRADLE_BIN="$INSTALL_DIR/bin/gradle"
DIST_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
ZIP_FILE="$CACHE_BASE/gradle-${GRADLE_VERSION}-bin.zip"
PART_FILE="$ZIP_FILE.part"

if [ -x "$GRADLE_BIN" ]; then
  exec "$GRADLE_BIN" "$@"
fi

if command -v gradle >/dev/null 2>&1; then
  VERSION="$(gradle --version 2>/dev/null | awk '/^Gradle / {print $2; exit}')"
  if [ "$VERSION" = "$GRADLE_VERSION" ]; then
    exec gradle "$@"
  fi
fi

command -v curl >/dev/null 2>&1 || { echo "خطأ: curl غير متوفر." >&2; exit 1; }
command -v unzip >/dev/null 2>&1 || { echo "خطأ: unzip غير متوفر." >&2; exit 1; }

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; return; fi
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'; return; fi
  echo "خطأ: sha256sum أو shasum مطلوب للتحقق من Gradle." >&2
  exit 1
}

verify_zip() {
  [ -f "$ZIP_FILE" ] || return 1
  [ "$(sha256_file "$ZIP_FILE")" = "$GRADLE_SHA256" ]
}

mkdir -p "$CACHE_BASE"
if ! verify_zip; then
  rm -f "$ZIP_FILE" "$PART_FILE"
  echo "Downloading and verifying Gradle $GRADLE_VERSION..."
  curl --fail --location --retry 3 --retry-delay 2 --connect-timeout 20 --max-time 600 \
    "$DIST_URL" -o "$PART_FILE"
  [ "$(sha256_file "$PART_FILE")" = "$GRADLE_SHA256" ] || { echo "خطأ: فشل التحقق من SHA-256 لتوزيعة Gradle." >&2; rm -f "$PART_FILE"; exit 1; }
  mv "$PART_FILE" "$ZIP_FILE"
fi

TMP_DIR="$CACHE_BASE/.extract-$$"
rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"
unzip -q "$ZIP_FILE" -d "$TMP_DIR"
[ -x "$TMP_DIR/gradle-$GRADLE_VERSION/bin/gradle" ] || { echo "خطأ: توزيعة Gradle غير مكتملة." >&2; rm -rf "$TMP_DIR"; exit 1; }
rm -rf "$INSTALL_DIR"
mv "$TMP_DIR/gradle-$GRADLE_VERSION" "$INSTALL_DIR"
rm -rf "$TMP_DIR"

exec "$GRADLE_BIN" "$@"
